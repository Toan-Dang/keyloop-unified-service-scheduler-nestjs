# Copy to .env for local runs.  No real secrets ever live in this repo (§14).

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- PostgreSQL (docker-compose service `postgres`) ---
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler_dev_pw
POSTGRES_DB=scheduler
POSTGRES_PORT=5432
DATABASE_URL=postgresql://scheduler:scheduler_dev_pw@localhost:5432/scheduler?schema=public

# --- Redis (docker-compose service `redis`) — idempotency fast path, non-fatal ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Booking / concurrency knobs (§6.2) ---
# Lock wait cap inside the allocation transaction. On 55P03 we move to the next candidate.
BOOKING_LOCK_TIMEOUT_MS=2000
# Prisma interactive-transaction timeout — must comfortably exceed lock_timeout + loop work.
BOOKING_TX_TIMEOUT_MS=10000
# Bounded whole-transaction restarts on 40P01 (deadlock_detected).
BOOKING_DEADLOCK_RETRIES=3

# --- Idempotency cache TTLs (§6.3) ---
IDEMPOTENCY_TTL_CREATED_SECONDS=86400
IDEMPOTENCY_TTL_CONFLICT_SECONDS=60

# --- Outbox relay (db §2.8) ---
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=8

# --- Reminder scheduler (§5.3) ---
REMINDER_CRON_ENABLED=true
REMINDER_LEAD_HOURS=24
REMINDER_BAND_HOURS=1

# --- Auth stub (§14) — tenant comes ONLY from the token, never the body ---
AUTH_ENABLED=true
