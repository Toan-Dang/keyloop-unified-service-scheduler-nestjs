# Copy to .env for local runs.  No real secrets ever live in this repo (§14).

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- PostgreSQL (docker-compose service `postgres`) ---
POSTGRES_USER=scheduler
POSTGRES_PASSWORD=scheduler_dev_pw
POSTGRES_DB=scheduler
POSTGRES_PORT=5432
DATABASE_URL=postgresql://scheduler:scheduler_dev_pw@localhost:5432/scheduler?schema=public
# pg.Pool max size. instances × DATABASE_POOL_SIZE must stay under Postgres's max_connections (§10).
DATABASE_POOL_SIZE=20

# --- Redis (docker-compose service `redis`) — idempotency fast path, non-fatal ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Booking / concurrency knobs (§6.2) ---
# Lock wait cap inside the allocation transaction. On 55P03 we move to the next candidate.
BOOKING_LOCK_TIMEOUT_MS=2000
# Prisma interactive-transaction timeout — must comfortably exceed lock_timeout + loop work.
BOOKING_TX_TIMEOUT_MS=10000
# Bounded whole-transaction restarts on 40P01 (deadlock_detected).
BOOKING_DEADLOCK_RETRIES=3

# --- Idempotency cache TTLs (§6.3) ---
IDEMPOTENCY_TTL_CREATED_SECONDS=86400
IDEMPOTENCY_TTL_CONFLICT_SECONDS=60

# --- Outbox relay (db §2.8) ---
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=8

# --- Reminder scheduler (§5.3) ---
REMINDER_CRON_ENABLED=true
REMINDER_LEAD_HOURS=24
REMINDER_BAND_HOURS=1

# --- Auth stub (§14) — tenant comes ONLY from the token, never the body ---
AUTH_ENABLED=true
# Required only when AUTH_ENABLED=false: every request is then treated as a fixed STAFF
# principal for this dealership (pure local convenience — curl/Swagger without minting a token).
# AUTH_DEV_DEALERSHIP_ID=

# --- Rate limiting (§7.1, 429 RATE_LIMITED) ---
# Off by default under NODE_ENV=test (the concurrency suite deliberately fires N parallel
# requests at one endpoint). Set explicitly to override that default in any environment.
# RATE_LIMIT_ENABLED=true
# API-wide default: requests per client IP per window. POST /appointments and
# POST /appointments/:id/cancel carry their own tighter, fixed limit (see write-throttle.ts).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
