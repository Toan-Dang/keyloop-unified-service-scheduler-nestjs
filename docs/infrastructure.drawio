          <mxGeometry x="40" y="360" width="150" height="70" as="geometry" />
        </mxCell>

        <!-- Framing note -->
        <mxCell id="note" value="TARGET PRODUCTION TOPOLOGY.  This repo runs local-first (docker-compose: Postgres + Redis only, no AWS / no LocalStack) — see infrastructure-local.drawio.&#10;The transactional core is identical in both; only the NotificationPublisher adapter differs — in-process @nestjs/event-emitter locally vs SNS/SQS in prod (ADR-005)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=#FFF8E1;strokeColor=#F9A825;fontColor=#5D4037;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="360" height="105" as="geometry" />
        </mxCell>

        <!-- Edge / compute -->
