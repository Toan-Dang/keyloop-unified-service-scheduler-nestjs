        <mxCell id="redis" value="ElastiCache&#10;Redis 8&#10;idempotency / lock" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#E3F2FD;strokeColor=#1565C0;fontColor=#0D47A1;fontSize=11;" vertex="1" parent="1">
