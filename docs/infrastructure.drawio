        <mxCell id="aws" value="AWS Cloud  (region: ap-southeast-1)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;strokeColor=#ED7100;fillColor=none;verticalAlign=top;fontStyle=1;fontSize=13;fontColor=#ED7100;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="230" y="30" width="1210" height="850" as="geometry" />
