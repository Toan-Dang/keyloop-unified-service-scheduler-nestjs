          <mxGeometry x="330" y="300" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fargate" value="ECS Fargate&#10;Booking Core&#10;(NestJS modular monolith)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0B2;strokeColor=#ED7100;fontColor=#5D4037;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="290" width="170" height="90" as="geometry" />
