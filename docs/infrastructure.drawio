<mxfile host="app.diagrams.net" agent="Cowork" version="24.7.0">
  <diagram id="scenarioA-infra" name="Infrastructure - Unified Service Scheduler">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="920" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

